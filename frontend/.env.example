# Firebase Configuration (for frontend authentication only)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API URL
# For Docker: use http://backend:8000/api/v1 (internal network)
# For local dev: use http://localhost:8003/api/v1 (backend runs on 8003 in docker-compose)
# For custom setup: adjust based on your backend port
VITE_API_URL=http://localhost:8003/api/v1

# NOTE: Gemini API key is NOT needed here
# AI-powered receipt scanning is handled entirely on the backend
# The frontend sends images to the backend /extract endpoint for processing
