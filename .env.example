# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================

# The backend uses a Firebase service account JSON file for authentication
# This is the recommended approach by Google
#
# Setup:
# 1. Download your service account JSON from Firebase Console
#    -> Project Settings -> Service Accounts -> Generate New Private Key
# 2. Place the JSON file in the project root directory as: firebaseservice.json
# 3. The backend will automatically load it from there (or from FIREBASE_CREDENTIALS_PATH)
#
# Optional: Override the default path if needed
# FIREBASE_CREDENTIALS_PATH=/custom/path/to/firebaseservice.json

# ============================================================================
# GEMINI API
# ============================================================================

# From Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ============================================================================
# SECURITY
# ============================================================================

# The backend refuses to start with the value below, so a copy-pasted .env
# fails fast. Replace it with a secure random string:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER rotate it after real data exists (invalidates logins + AI-key decryption).
SECRET_KEY=change-me-in-production

# ============================================================================
# INFRASTRUCTURE (consumed by docker-compose.yml)
# ============================================================================

# Postgres + Redis passwords — change both in production
DB_PASSWORD=scanapp_dev
REDIS_PASSWORD=redis_dev

# First local admin, auto-created on first boot (AUTH_MODE=local)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin12345

# Async batch concurrency (free AI tiers: 1-2)
MAX_AI_CONCURRENCY=4

# Frontend API base, baked into the image at build time.
# Leave relative so the UI talks to the same host through Nginx.
VITE_API_URL=/api/v1

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# CORS origins (comma-separated, or "*" for any)
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# API settings
API_TITLE=Scan App API
API_VERSION=1.0.0
ENABLE_DOCS=true

# Logging
LOG_LEVEL=INFO

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env to version control (.env is gitignored)
# 4. Firebase is LEGACY: only needed for AUTH_MODE=firebase. The default
#    AUTH_MODE=local uses Postgres users + locally-signed JWTs and ignores
#    firebaseservice.json entirely — you do NOT need it for self-hosting.
# 5. See DEPLOYMENT.md for the full self-host runbook (migrate before first boot!).
#
