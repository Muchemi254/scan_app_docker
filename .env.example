# ============================================================================
# Scan App — environment template
#
# Setup:  cp .env.example .env   →  change ONLY the values marked (REQUIRED)
# Everything else has a working default. docker-compose.yml and
# backend/app/core/config.py read all of these from .env.
# ============================================================================

# ───────────────────────────────────────────────────────────────────────────
# REQUIRED — change these values (the backend refuses to boot with the
# placeholders below, so copy-paste fails fast and tells you what to fix)
# ───────────────────────────────────────────────────────────────────────────

# MUST change. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER rotate it later (invalidates logins + AI-key decryption).
SECRET_KEY=change-me-in-production

# MUST change. First admin login (email: ADMIN_EMAIL below). Backend refuses
# to boot with this default.
ADMIN_PASSWORD=admin12345

# Set only if you want AI scanning (Gemini). From Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ───────────────────────────────────────────────────────────────────────────
# OPTIONAL — safe local defaults. Strengthen if exposing beyond your machine.
# ───────────────────────────────────────────────────────────────────────────

# Postgres password (also used by backend/worker DATABASE_URL).
DB_PASSWORD=scanapp_dev
# Redis broker password.
REDIS_PASSWORD=redis_dev
# First admin login email.
ADMIN_EMAIL=admin@local

# ───────────────────────────────────────────────────────────────────────────
# DEFAULTS — everything below has a sensible default; leave as-is unless you
# know you need to change it.
# ───────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=scanapp
POSTGRES_USER=scanapp
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
USE_POSTGRES=true

# Redis / Celery
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
MAX_AI_CONCURRENCY=4

# Run `alembic upgrade head` automatically at backend startup. On by default so
# a fresh install works with plain `docker compose up -d --build`.
RUN_MIGRATIONS=true

# Storage (paths are container-internal)
IMAGE_STORAGE_DIR=/app/data/images
BACKUP_STORAGE_DIR=/app/backups
REVIEW_BATCH_DB_PATH=/app/data/review_batches.db
MAX_UPLOAD_SIZE=10485760

# Auth
AUTH_MODE=local
JWT_EXPIRE_DAYS=30
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API / server
API_TITLE=Scan App API
API_VERSION=1.0.0
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
RELOAD=false
ENABLE_DOCS=true
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80
ALLOWED_HOSTS=*

# Frontend API base, baked into the image at build time. Leave relative so the
# UI talks to the same host through Nginx.
VITE_API_URL=/api/v1

# ───────────────────────────────────────────────────────────────────────────
# FIREBASE (LEGACY — only for AUTH_MODE=firebase, ignored in local mode)
# ───────────────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=/app/firebaseservice.json

# ============================================================================
# NOTES
# ============================================================================
# 1. Copy to .env, change the REQUIRED section, run the DEPLOYMENT.md runbook.
# 2. .env is gitignored — never commit it.
# 3. docker compose aborts with a clear error if SECRET_KEY / DB_PASSWORD /
#    REDIS_PASSWORD / ADMIN_* are missing.
#