# One-shot collation auto-fix runner (see collation_fix.sh).
#
# Deliberately tiny: plain Debian postgres:16 (glibc) with just the fix script —
# no Wal-G — so this service builds and pulls fast on every self-hosted install.
# MUST stay Debian-based: the whole point is to run the glibc postgres binaries.
FROM postgres:16

COPY collation_fix.sh /usr/local/bin/collation_fix.sh
RUN chmod +x /usr/local/bin/collation_fix.sh

# Replace the official postgres entrypoint — this image exists ONLY to run the
# one-shot script, never to boot a server.
ENTRYPOINT ["/usr/local/bin/collation_fix.sh"]
